# Copy to .env.production on the server and fill in. Never commit .env.production.

# --- Required ---
SITE_ADDRESS=bd.example.com                 # your domain (DNS A record -> server IP)
POSTGRES_PASSWORD=                          # openssl rand -hex 24
SECRET_KEY=                                 # openssl rand -hex 32
JWT_SECRET_KEY=                             # openssl rand -hex 32

# Internal service URLs (match container names; usually leave as-is)
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/uk_ops_bd
REDIS_URL=redis://redis:6379/0

# CORS — same-origin via Caddy, so just your site
CORS_ORIGINS=["https://bd.example.com"]
FRONTEND_URL=https://bd.example.com

# --- External API keys (features degrade gracefully without them) ---
COMPANIES_HOUSE_API_KEY=
EPC_API_KEY=                                # format: your_email:your_api_key
APOLLO_API_KEY=
HUNTER_API_KEY=
ANTHROPIC_API_KEY=                          # AI enrichment panel

# --- Optional ---
SENTRY_DSN=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PROXY_URL=                                  # scraping proxy, if any
